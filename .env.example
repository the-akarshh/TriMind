# ==============================================================================
# APTITUDE ARENA - Environment Variables
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aptitudearina?schema=public"

# Authentication Secrets
# Used to sign session tokens and JWTs (generate with: openssl rand -base64 32)
JWT_SECRET="arena_super_secret_jwt_token_for_college_placement_prep_key_32bytes"
SESSION_MAX_AGE_DAYS=7

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:3000"

# Node Environment
NODE_ENV="development"
